{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LockVoice": {
        "enum": [
          "leader",
          "follower",
          "none"
        ],
        "type": "string"
      },
      "ObjectivePreset": {
        "enum": [
          "reduce_repetition",
          "smooth_bass",
          "strengthen_cadence",
          "general_polish"
        ],
        "type": "string"
      },
      "PolishObjectiveWeights": {
        "additionalProperties": false,
        "properties": {
          "bass_smoothness_penalty": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bass Smoothness Penalty"
          },
          "cadence_motion_reward": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cadence Motion Reward"
          },
          "leap_penalty": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Leap Penalty"
          },
          "repeated_note_penalty": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Repeated Note Penalty"
          }
        },
        "title": "PolishObjectiveWeights",
        "type": "object"
      },
      "PolishRequest": {
        "additionalProperties": false,
        "properties": {
          "bar_end": {
            "minimum": 1.0,
            "title": "Bar End",
            "type": "integer"
          },
          "bar_start": {
            "minimum": 1.0,
            "title": "Bar Start",
            "type": "integer"
          },
          "lock_voice": {
            "$ref": "#/components/schemas/LockVoice",
            "default": "none"
          },
          "max_variants": {
            "default": 6,
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Max Variants",
            "type": "integer"
          },
          "objective_overrides": {
            "$ref": "#/components/schemas/PolishObjectiveWeights"
          },
          "objective_preset": {
            "$ref": "#/components/schemas/ObjectivePreset",
            "default": "general_polish"
          },
          "rewrite_voice": {
            "$ref": "#/components/schemas/RewriteVoice",
            "default": "auto"
          }
        },
        "required": [
          "bar_start",
          "bar_end"
        ],
        "title": "PolishRequest",
        "type": "object"
      },
      "RenderFormat": {
        "enum": [
          "pdf",
          "svg",
          "png"
        ],
        "type": "string"
      },
      "RenderRequest": {
        "properties": {
          "formats": {
            "items": {
              "$ref": "#/components/schemas/RenderFormat"
            },
            "minItems": 1,
            "title": "Formats",
            "type": "array"
          }
        },
        "required": [
          "formats"
        ],
        "title": "RenderRequest",
        "type": "object"
      },
      "RewriteVoice": {
        "enum": [
          "leader",
          "follower",
          "auto"
        ],
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
